rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner = the admin's Google account
    // TEMPLATE: 아래 이메일을 본인 Google 계정으로 교체하세요 (src/site.config.js의 ownerEmail과 일치)
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'your-google-account@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /site/{doc} {
      // Portfolio data is read by the client app (content, hashed tokens, logs)
      allow read: if true;
      // Content writes: owner only. Visitor-generated logs stay open
      // (gate visits, access heartbeats, security alerts must be writable pre-auth).
      allow write: if isOwner() || doc in ['access_log', 'gate_log', 'alert_log'];

      // Version history snapshots: owner only (read and write)
      match /history/{snap} {
        allow read, write: if isOwner();
      }
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
